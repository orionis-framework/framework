# Application configuration
APP_NAME="Orionis"
APP_ENV="development"
APP_DEBUG=true
APP_TIMEZONE="UTC"
APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
APP_LANGUAGE_PATH="resources/lang/"
APP_CIPHER="AES-256-CBC"
APP_KEY=""
APP_MAINTENANCE=false

# Password hashing configuration
HASH_DRIVER="argon2"

ARGON_MEMORY=65536
ARGON_THREADS=4
ARGON_TIME=3

BCRYPT_ROUNDS=12

# Cache configuration
CACHE_STORE="memory"
CACHE_PREFIX=""

CACHE_FILE_PATH="storage/framework/cache"

REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

MEMCACHED_HOST="127.0.0.1"
MEMCACHED_PORT=11211

DB_CACHE_CONNECTION="sqlite"
DB_CACHE_TABLE="cache"
DB_CACHE_LOCK_TABLE="cache_locks"

# Database configuration
DB_CONNECTION="sqlite"
DB_URL=""
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_DATABASE="database/database.sqlite"
DB_USERNAME="root"
DB_PASSWORD=""
DB_PREFIX=""
DB_SOCKET=""
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"
DB_FOREIGN_KEYS="off"
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE="delete"
DB_SYNCHRONOUS="normal"
DB_SERVICE_NAME="ORCL"
DB_SID=null
DB_DSN=null
DB_TNS=null
DB_ENCODING="AL32UTF8"
DB_NENCODING="AL32UTF8"
DB_ENCRYPT="yes"
DB_TRUST_SERVER_CERTIFICATE=true
DB_ODBC_DRIVER="ODBC Driver 18 for SQL Server"

# Filesystem configuration
FILESYSTEM_DISK="local"

# AWS S3
S3_KEY=""
S3_SECRET=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_URL=null
S3_ENDPOINT=null
S3_USE_PATH_STYLE_ENDPOINT=false

# Azure
AZURE_CONNECTION_STRING=""
AZURE_ACCOUNT_NAME=""
AZURE_ACCOUNT_KEY=""
AZURE_CONTAINER=""
AZURE_URL=null

# Google Cloud Storage
GCS_PROJECT_ID=""
GCS_KEY_FILE=null
GCS_BUCKET=""
GCS_URL=null

# Local Storage
LOCAL_PATH="storage/app/private"

# Public Storage
PUBLIC_PATH="storage/app/public"
PUBLIC_URL="/static"

















# HTTP configuration
TRUSTED_PROXIES="list:[]"

ALLOWED_HOSTS="list:[]"

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

CORS_ALLOW_ORIGINS="list:[]"
CORS_ALLOW_ORIGIN_REGEX=null
CORS_ALLOW_METHODS="list:[]"
CORS_ALLOW_HEADERS="list:[]"
CORS_EXPOSE_HEADERS="list:[]"
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# Logging configuration
LOG_CHANNEL="stack"

# Session configuration
SESSION_DRIVER="file"
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_FILES="storage/framework/sessions"
SESSION_COOKIE="sessionid"
SESSION_PATH="/"
SESSION_DOMAIN=null
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE="lax"
SESSION_PARTITIONED=false

# Testing configuration
TESTING_VERBOSITY=2
TESTING_FAIL_FAST=false
TESTING_START_DIR="tests"
TESTING_FILE_PATTERN="test_*.py"
TESTING_METHOD_PATTERN="test*"
TESTING_CACHE_RESULTS=false