import sys
from orionis.console.startup import startup_feedback

if __name__ == "__main__":
    """
    Entry point for the reactor CLI.

    Parameters
    ----------
    argv : list[str]
        The command-line arguments passed to the application.

    Returns
    -------
    int
        The exit code returned by the reactor loop.
    """
    with startup_feedback(sys.argv):
        from orionis.console.stdio import protocol_stdio

        with protocol_stdio(sys.argv):
            from orionis.aio import Loop
            from bootstrap.app import app

            sys.exit(
                Loop.run(
                    app.handleCommand(sys.argv),
                ),
            )
