# Application
APP_NAME="Orionis Application"
APP_ENV="development"
APP_DEBUG=True
APP_TIMEZONE="UTC"
APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
# APP_LANGUAGE_PATH="resources/lang/"
# APP_CIPHER="AES-256-CBC"
APP_KEY=
APP_MAINTENANCE=False
APP_URL=

# Authentication - Identity and Session
# AUTH_GUARD="session"
# AUTH_MODEL="app.models.user.User"
# AUTH_USERNAME="email"
# AUTH_SESSION_KEY="_auth_identifier"
AUTH_REDIRECT_TO="/login"
AUTH_HOME="/home"

# Authentication - Tokens
# AUTH_TOKEN_TABLE="personal_access_tokens"
# AUTH_TOKEN_EXPIRATION=null
# AUTH_TOKEN_SECRET_BYTES=40

# Authentication - Password Reset
# AUTH_PASSWORD_RESET_EXPIRATION=60
# AUTH_PASSWORD_RESET_THROTTLE=60
# AUTH_PASSWORD_RESET_TABLE="password_reset_tokens"

# Authentication - Remember Me
# AUTH_REMEMBER_COOKIE="orionis_remember"
# AUTH_REMEMBER_LIFETIME=43200
# AUTH_REMEMBER_SECURE=True

# Cache
CACHE_STORE="file"
# CACHE_PREFIX="orionis:"
CACHE_FILE_PATH="storage/framework/cache/data"
# DB_CACHE_CONNECTION=null
# DB_CACHE_TABLE="cache"
# DB_CACHE_LOCK_TABLE="cache_locks"

# Redis - shared by cache, rate limiting, queues and scheduler
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Memcached
MEMCACHED_HOST="127.0.0.1"
MEMCACHED_PORT=11211

# Database - Shared Connection Settings
DB_CONNECTION="sqlite"
DB_DATABASE="database/database.sqlite"
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_USERNAME="postgres"
# DB_PASSWORD="replace-with-server-credential"
# DB_PREFIX="app_"
# DB_PREFIX_INDEXES=True
# DB_CHARSET applies to the selected driver: mysql=utf8mb4, pgsql/sqlserver=UTF8.
# DB_CHARSET="utf8mb4"

# Database - SQLite
# DB_URL=null
# DB_FOREIGN_KEYS="OFF"
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE="DELETE"
# DB_SYNCHRONOUS="NORMAL"

# Database - MySQL
# DB_SOCKET="/var/run/mysqld/mysqld.sock"
# DB_COLLATION="utf8mb4_unicode_ci"
# DB_STRICT=True
# DB_ENGINE="InnoDB"

# Database - PostgreSQL
# DB_SEARCH_PATH="public"
# DB_SSLMODE="prefer"

# Database - Oracle
# DB_SERVICE_NAME="ORCL"
# DB_SID=null
# DB_DSN=null
# DB_TNS=null
# DB_ENCODING="AL32UTF8"
# DB_NENCODING="AL16UTF16"

# Database - SQL Server
# DB_ENCRYPT="yes"
# DB_TRUST_SERVER_CERTIFICATE=True
# DB_ODBC_DRIVER="ODBC Driver 18 for SQL Server"

# Database - Amazon Redshift (DB_CONNECTION="redshift", DB_PORT=5439)
# DB_REDSHIFT_SSL=True
# DB_REDSHIFT_SSLMODE="verify-full"
# DB_REDSHIFT_TIMEOUT=30
# DB_REDSHIFT_IAM=False
# DB_REDSHIFT_REGION=null
# DB_REDSHIFT_CLUSTER_IDENTIFIER=null
# DB_REDSHIFT_DB_USER=null
# DB_REDSHIFT_PROFILE=null
# DB_REDSHIFT_IS_SERVERLESS=False
# DB_REDSHIFT_SERVERLESS_WORK_GROUP=null
# DB_REDSHIFT_SERVERLESS_ACCT_ID=null

# Filesystems - Local and Public
FILESYSTEM_DISK="local"
LOCAL_PATH="storage/app/private"
PUBLIC_PATH="storage/app/public"
PUBLIC_URL="/static"

# Filesystems - S3
# S3_KEY="replace-with-s3-key"
# S3_SECRET="replace-with-s3-credential"
# S3_REGION="us-east-1"
# S3_BUCKET="your-bucket"
# S3_URL=null
# S3_ENDPOINT=null
# S3_USE_PATH_STYLE_ENDPOINT=False

# Filesystems - Azure
# AZURE_CONNECTION_STRING="replace-with-azure-connection-string"
# AZURE_ACCOUNT_NAME="your-account"
# AZURE_ACCOUNT_KEY="replace-with-azure-credential"
# AZURE_CONTAINER="your-container"
# AZURE_URL=null

# Filesystems - Google Cloud Storage
# GCS_PROJECT_ID="your-project"
# GCS_KEY_FILE=null
# GCS_BUCKET="your-bucket"
# GCS_URL=null

# Hashing
HASH_DRIVER="argon2"
# ARGON_MEMORY=65536
# ARGON_THREADS=4
# ARGON_TIME=3
# BCRYPT_ROUNDS=12

# HTTP - Rate Limiting
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# RATE_LIMIT_STORE="memory"
# RATE_LIMIT_MAX_KEYS=10000
# RATE_LIMIT_MAX_EVENTS=100000
# RATE_LIMIT_REDIS_PREFIX="orionis:http:rate-limit"
# RATE_LIMIT_REDIS_TIMEOUT=1

# HTTP - Request Body and Uploads
# HTTP_MAX_BODY_SIZE=16777216
# HTTP_MAX_BUFFER_SIZE=2097152
# HTTP_MAX_CONCURRENT_REQUESTS=128
# HTTP_MAX_FILES=32
# HTTP_MAX_FIELDS=128
# HTTP_MAX_PART_SIZE=10485760
# HTTP_MAX_FIELD_SIZE=1048576
# HTTP_MAX_PART_HEADER_SIZE=16384
# HTTP_UPLOAD_MEMORY_THRESHOLD=262144
# HTTP_MAX_MULTIPART_MEMORY_SIZE=8388608
# HTTP_MONITOR_DISCONNECTS=False

# HTTP - Proxies and Hosts
# TRUSTED_PROXIES="list:['127.0.0.1']"
# ALLOWED_HOSTS="list:[]"

# HTTP - CORS
# Shared with WebSocket and MCP; MCP requires explicit HTTP(S) origins, not '*'.
CORS_ALLOW_ORIGINS="list:[]"
CORS_ALLOW_ORIGIN_REGEX=None
CORS_ALLOW_METHODS="list:[]"
CORS_ALLOW_HEADERS="list:[]"
CORS_EXPOSE_HEADERS="list:[]"
CORS_ALLOW_CREDENTIALS=False
CORS_MAX_AGE=600

# HTTP - CSRF
# CSRF_ENABLED=True
# CSRF_TOKEN_LENGTH=32
# CSRF_SESSION_KEY="_csrf_token"
CSRF_XSRF_COOKIE=False
CSRF_COOKIE_NAME="XSRF-TOKEN"
# CSRF_COOKIE_SECURE=False
# CSRF_COOKIE_SAME_SITE="lax"
# CSRF_COOKIE_PATH="/"
# CSRF_COOKIE_DOMAIN=null

# WebSocket
# WEBSOCKET_MAX_CONNECTIONS=128
# WEBSOCKET_MAX_MESSAGE_SIZE=1048576

# Realtime
# REALTIME_MAX_MESSAGE_SIZE=1048576
# REALTIME_MAX_CONCURRENT_INVOCATIONS=16
# REALTIME_MAX_PENDING_CLIENT_INVOCATIONS=32
# REALTIME_INVOCATION_TIMEOUT=30.0
# REALTIME_CLIENT_RESULT_TIMEOUT=30.0
# REALTIME_BROADCAST_CONCURRENCY=32
# REALTIME_MAX_GROUPS_PER_CONNECTION=64

# MCP
# MCP budgets are read at construction; browser origins use CORS_ALLOW_ORIGINS.
# Request size and concurrency fall back to HTTP limits when those are set.
# MCP_MAX_REQUEST_SIZE=1048576
# MCP_DEFAULT_PAGE_SIZE=50
# MCP_MAX_PAGE_SIZE=100
# MCP_MAX_CONCURRENT_REQUESTS=32
# MCP_SUBSCRIPTION_BUFFER_SIZE=64
# MCP_MAX_SUBSCRIPTIONS=1024
# MCP_MAX_RESOURCE_SUBSCRIPTIONS=64
# MCP_SUBSCRIPTION_KEEPALIVE=15.0
# MCP_TOOL_SEARCH_MAX_RESULTS=20
# MCP_TOOL_SEARCH_MAX_CALLS=5
# MCP_TOOL_SEARCH_MAX_OUTPUT_BYTES=262144
# MCP_MAX_RESPONSE_SIZE=4194304
# MCP_MAX_METADATA_SIZE=65536

# Server - Granian Startup Metadata
# These only affect the startup panel; listener options belong to the server CLI.
# GRANIAN_HOST="127.0.0.1"
# GRANIAN_PORT=8000
# GRANIAN_INTERFACE="rsgi"

# Logging
LOG_CHANNEL="stack"
LOG_LEVEL="info"
# Rotating channels require {suffix} in LOG_PATH, e.g. storage/logs/daily_{suffix}.log.
# LOG_PATH="storage/logs/stack.log"
# LOG_RETENTION uses hours/days/weeks/months; defaults are 24/7/4/4 respectively.
# LOG_RETENTION=4
# LOG_ROTATION_TIME="00:00"
# LOG_MB_SIZE=10
# LOG_FILES=5

# Mail - Sender and SMTP
MAIL_MAILER="smtp"
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
# A nonempty MAIL_URL takes precedence over individual SMTP settings.
# The str: prefix preserves an empty string instead of converting it to None.
# MAIL_URL="str:"
MAIL_HOST="localhost"
MAIL_PORT=587
# MAIL_ENCRYPTION="TLS"
# MAIL_USERNAME="replace-with-smtp-user"
# MAIL_PASSWORD="replace-with-smtp-credential"
# MAIL_TIMEOUT=null

# Mail - File Transport
# MAIL_FILE_PATH="storage/mail"

# Scheduler
TASKS_STORE="memory"
# TASKS_MAX_INSTANCES=1
# TASKS_COALESCE=True
# TASKS_MISFIRE_GRACE_TIME=30
# TASKS_REPLACE_EXISTING=True
# TASKS_JITTER=0
# DB_TASK_CONNECTION="sqlite"
# DB_TASK_TABLE="scheduler_tasks"
# REDIS_TASKS_KEY="scheduler:tasks"
# REDIS_RUN_TIMES_KEY="scheduler:run_times"

# Queues - Default Connection
QUEUE_CONNECTION="sync"

# Queues - Sync
QUEUE_SYNC_QUEUE="default"
QUEUE_SYNC_RETRY_AFTER=90.0

# Queues - Database
QUEUE_DB_CONNECTION=null
QUEUE_TABLE="jobs"
QUEUE_DB_QUEUE="default"
QUEUE_DB_RETRY_AFTER=90.0

# Queues - Redis
QUEUE_REDIS_PREFIX="orionis:queues"
QUEUE_REDIS_QUEUE="default"
QUEUE_REDIS_RETRY_AFTER=90.0

# Queues - Failed Jobs
QUEUE_FAILED_DB_CONNECTION=null
QUEUE_FAILED_TABLE="failed_jobs"

# Queues - Worker
QUEUE_WORKER_CONCURRENCY=1
QUEUE_WORKER_SLEEP=1.0
QUEUE_WORKER_TIMEOUT=60.0
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_BACKOFF="tuple:(0.0,)"

# Sessions
SESSION_DRIVER="memory"
SESSION_LIFETIME=120
# SESSION_EXPIRE_ON_CLOSE=False
# SESSION_TRACK_PREVIOUS_URL=True
# SESSION_RENEWAL_INTERVAL=0
# SESSION_FILES="storage/framework/sessions"
# SESSION_DB_CONNECTION=null
# SESSION_DB_TABLE="sessions"
# SESSION_CACHE_STORE=null
SESSION_COOKIE="sessionid"
# SESSION_PATH="/"
# SESSION_DOMAIN=null
# SESSION_SECURE=False
# SESSION_HTTP_ONLY=True
# SESSION_SAME_SITE="lax"
# SESSION_PARTITIONED=False

# Views
# VIEW_PATHS="list:['resources/views']"
# VIEW_CACHE_SIZE=400
# VIEW_CACHE_PATH="storage/framework/views"
# VIEW_AUTOESCAPE=True
# View auto_reload follows APP_DEBUG; it has no separate environment variable.

# Testing
TESTING_VERBOSITY=2
# TESTING_FAIL_FAST=False
# TESTING_START_DIR="tests"
# TESTING_FILE_PATTERN="test_*.py"
# TESTING_METHOD_PATTERN="test*"
# TESTING_CACHE_RESULTS=False
